# Docker Compose reads .env. Native installs use Settings or exported environment variables.
# Leave keys empty to use the sample, import a transcript, or edit manually.
OPENAI_API_KEY=
GOODTAKE_EDITOR_MODEL=gpt-5.1
ELEVENLABS_API_KEY=
# Local Whisper is the default transcription and export speech-check provider.
GOODTAKE_WHISPER_MODEL=base.en
# Media, settings, queue, and exports stay outside the repository.
# GOODTAKE_HOME=/path/to/private/goodtake-data
# CHROME_PATH=/absolute/path/to/chromium
